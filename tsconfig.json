{
  "compilerOptions": {
    "allowJs": true,
    "sourceMap": true,
    "target": "es6",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es5", "es6", "dom"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
  
    "tsBuildInfoFile": ".tsbuildinfo",
    "incremental": true,
    "outDir": "./lib"
  },
  "include": ["./src"]
}


